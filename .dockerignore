.git
.run
**/.venv/
**/node_modules/
**/dist/
**/__pycache__/
**/*.py[cod]
**/.env
data/**
!data/.gitkeep
# Trained bundles are runtime-mounted (docker-compose ./models:/models:ro),
# never baked into an image. Excluding them keeps builds reproducible and
# guarantees no COPY can pick up a host-specific artifact.
models/**
!models/.gitkeep
*.log
Thumbs.db
.DS_Store
